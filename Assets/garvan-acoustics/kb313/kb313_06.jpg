    if (isBusy) {
      if (btn.dataset._cf7Label === undefined) {
        btn.dataset._cf7Label = btn.value || btn.textContent || '';
      }

      btn.disabled = true;
      form.setAttribute('aria-busy', 'true');

      if (btn.tagName === 'INPUT') btn.value = 'Please wait...';
      else btn.textContent = 'Please wait...';

    } else {
      btn.disabled = false;
      form.removeAttribute('aria-busy');

      const old = btn.dataset._cf7Label || '';
      if (old) {
        if (btn.tagName === 'INPUT') btn.value = old;
        else btn.textContent = old;
      }
    }
  }

  document.addEventListener('wpcf7beforesubmit', function (e) {
    const form = e.target;
    if (!form) return;

    if (pending.has(form)) {
      e.preventDefault?.();
      e.stopImmediatePropagation?.();
      return false;
    }

    pending.add(form);
    setBusy(form, true);
  }, true);

  const unlock = function (e) {
    const form = e.target;
    if (!form) return;
    pending.delete(form);
    setBusy(form, false);
  };

  document.addEventListener('wpcf7submit', unlock, true);
  document.addEventListener('wpcf7mailsent', unlock, true);
  document.addEventListener('wpcf7mailfailed', unlock, true);
  document.addEventListener('wpcf7spam', unlock, true);
  document.addEventListener('wpcf7invalid', unlock, true);
  document.addEventListener('wpcf7abort', unlock, true);

})();
//# sourceURL=contact-form-7-js-after
/* ]]> */
</script>
