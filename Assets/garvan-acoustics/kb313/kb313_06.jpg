		<style type="text/css" id="wp-custom-css">
			/* GARVAN DAY - Migliora checkbox privacy da mobile */
@media (max-width: 767px) {

  /* Contenitore consenso privacy */
  .wpcf7-list-item {
    display: flex !important;
    align-items: flex-start !important;
    gap: 14px !important;
    margin-left: 0 !important;
  }

  /* Checkbox più grande e cliccabile */
  .wpcf7-list-item input[type="checkbox"] {
    width: 24px !important;
    height: 24px !important;
    min-width: 24px !important;
    margin-top: 6px !important;
    accent-color: #000000;
  }

  /* Testo privacy più leggibile */
  .wpcf7-list-item-label {
    display: block !important;
    font-size: 18px !important;
    line-height: 1.55 !important;
  }

  /* Link privacy */
  .wpcf7-list-item-label a {
    font-size: 18px !important;
    line-height: 1.55 !important;
  }
}

/* =====================================================
   NAV / HEADER
===================================================== */

@media (min-width: 992px) {
  .navbar-fixed-top,
  .navbar-fixed-bottom {
    border-radius: 20px;
    margin: 20px;
  }

  section#hero-home {
    margin-top: -82px;
  }
}

.retina-logo,
.retina-logo-light {
  max-width: 80% !important;
}
.navbar > .nav-header-container {
width: 90%;
    max-width: 1280px;
    padding-top: 10px;
    padding-bottom: 10px;
}
/* =====================================================
   CTA PRODOTTI
===================================================== */

.ga-cta-box {
  background: #ffffff;
  border: 2px solid #f2cf7e;
  border-radius: 14px;
  padding: 20px;
  margin: 50px 6%;
  box-shadow: 0 8px 22px rgba(0,0,0,0.04);
}

.ga-cta-content h3 {
  margin: 0 0 12px 0;
  font-size: 22px;
  font-weight: 700;
  color: #1a1a1a;
}

.ga-cta-content p {
  font-size: 16px;
  line-height: 1.6;
  color: #444;
  margin-bottom: 12px;
}

.ga-cta-meta {
  font-size: 14px;
  color: #666;
  margin-bottom: 22px;
}

.ga-cta-buttons {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
}

.ga-btn {
  display: inline-block;
  padding: 12px 22px;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.25s ease;
  white-space: nowrap;
  text-transform: uppercase;
}

.ga-btn-primary {
  background: #F2CF7E;
  color: #000;
}

.ga-btn-primary:hover {
  background: #e6c36f;
}

.ga-btn-secondary {
  background: transparent;
  color: #000;
  border: 1px solid rgba(0,0,0,0.25);
}

.ga-btn-secondary:hover {
  background: rgba(0,0,0,0.03);
}

/* =====================================================
   BREADCRUMB / PAGE TITLE
===================================================== */

.breadcrumb-gray-text,
.breadcrumb-gray-text a {
  color: #575757;
}

.page-title .col-lg-8,
.page-title .col-lg-4,
.page-title .col-md-8,
.page-title .col-md-4 {
  width: 100% !important;
  max-width: 100% !important;
  flex: 0 0 100% !important;
}

.page-title .row {
  display: block !important;
}

@media (max-width: 767.98px) {
  .page-title .breadcrumb-gray-text {
    display: none !important;
  }
}


/* =====================================================
   HOME
===================================================== */

.title-box-home {
  font-weight: 600;
  color: black;
}

.title-box-home figure {
  display: block;
  width: 60%;
  min-width: 360px;
  margin: 0 auto;
  text-align: center;
  line-height: 1.5;
  transform: translateX(-50%);
  left: 50%;
  pointer-events: none;
}

.title-box-home .text-large::before {
  content: "";
  display: block;
  position: absolute;
  top: 0;
  left: 50%;
  width: 60%;
  height: 100%;
  background-color: #e3e3e3;
  opacity: 0.6;
  transform: translateX(-50%) scale(2);
  z-index: -1;
  pointer-events: none;
}

/* =====================================================
   LINK STYLES
===================================================== */

.link {
  color: #0070c9;
  font-size: 16px;
}

.link:hover {
  text-decoration: underline;
}

.link-white {
  color: #ffffff;
  font-size: 16px;
}

.link-white:hover {
  text-decoration: underline;
  color: #fff;
}


/* =====================================================
   TYPOGRAPHY
===================================================== */

h1, h2, h3, h4, h5 {
  text-transform: uppercase;
}

h2 {
  font-weight: 700;
}

.h5 {
  letter-spacing: 1px;
}

.text-med {
  line-height: 26px;
  font-size: 18px !important;
  font-weight: 300;
}

.titolo,
.titolo-black {
  font-size: 42px;
  line-height: 46px;
}

.titolo { color: #ffffff; }
.titolo-black { color: #303030; }

@media (max-width: 768px) {
  .titolo,
  .titolo-black {
    font-size: 30px;
    line-height: 32px;
  }
}


/* =====================================================
   BLOG / PORTFOLIO / IMMAGINI
===================================================== */

.blog-details-headline,
.standard-post-meta,
.padding-five-bottom,
.single-cpo_portfolio .single-image.wp-post-image {
  display: none;
}

.grid-gallery figure img,
.grid figure:hover .gallery-img,
.blog-image,
.blog-slider-con figcaption,
.wpb_single_image img {
  border-radius: 15px;
}

.owl-carousel .owl-item img {
  height: 250px !important;
  object-fit: cover;
}


.titolo-linea {
	    font-size: 45px;
    line-height: normal;
    color: white;
}

/* BLOCCO FINITURE DISPONIBILI — GARVAN */

.ga-finishes-block {
  --ga-title-size: 16px;
  --ga-link-size: 16px;
  --ga-dot-size: 30px;
  --ga-dot-gap: 10px;
  --ga-title-color: #000;
  --ga-link-color: #5d5d5d;
  --ga-link-hover-color: #000;

  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 7px;
  margin: 20px 0 0 0;
  text-decoration: none;
  font-family: Montserrat, system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  color: #1e1e1e;
}

.ga-finishes-title {
  font-size: var(--ga-title-size);
  letter-spacing: 0.10em;
  text-transform: uppercase;
  color: var(--ga-title-color);
  font-weight: 700;
  line-height: 1.2;
}

.ga-finishes-dots {
  display: flex;
  align-items: center;
  gap: var(--ga-dot-gap);
}

.ga-finishes-dots span {
  width: var(--ga-dot-size);
  height: var(--ga-dot-size);
  border-radius: 50%;
  background: var(--ga-finish-color);
  border: 1px solid rgba(0, 0, 0, 0.12);
  display: block;
}

.ga-finishes-link {
  font-size: var(--ga-link-size);
  line-height: 1.2;
  color: var(--ga-link-color);
  text-decoration: underline;
  padding-top: 5px;
  transition: color 0.2s ease;
}

.ga-finishes-block:hover .ga-finishes-link {
  color: var(--ga-link-hover-color);
}

/* BLOCCO FINITURE DISPONIBILI — NASCOSTO TEMPORANEAMENTE */
a.mat-fin {
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;

	/* RIMUOVI QUESTA RIGA PER MOSTRARE IL BLOCCO FINITURE */
	display: none !important;
}

/* =====================================================
   FORM / PRIVACY
===================================================== */

.privacy-home {
  color: white;
  font-size: 13px;
  font-style: italic;
}

.privacy-home input[type="submit"] {
  width: auto;
  background-color: #3CDBC0;
  font-weight: 800;
  border-radius: 15px;
}

.wpcf7 input[type="email"] {
  color: black;
}


/* =====================================================
   BOTTONI GENERALI
===================================================== */

.btn,
.btn-round {
  border-radius: 15px !important;
}

.btn-static {
  display: inline-block;
  margin: 25px 0 20px;
  background: rgba(255,214,160,0.9);
  color: #000;
  padding: 12px 24px;
  border-radius: 10px;
  font-size: 15px;
  font-weight: 600;
  text-decoration: none;
  text-transform: uppercase;
}

.btn-static:hover {
  background: rgba(255,214,160,0.9);
  color: #000;
}


/* =====================================================
   HACK / FIX PLUGIN / BROWSER
===================================================== */

/* Nasconde overlay esterni */
#shadow-host-companion,
#cmplz-manage-consent {
  display: none !important;
}

/* Safari – WP Table Builder fix */
.wptb-button-container,
.wptb-button-wrapper.wptb-size-s {
  width: auto !important;
  height: auto !important;
}

.wptb-button-wrapper.wptb-size-s > a.wptb-link-target {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: auto !important;
  height: auto !important;
  padding: 10px 16px !important;
}

.wptb-button-container {
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
}

/* ======== SEZIONE NEWSLETTER ======== */

.newsletter-section.bg-image{
  position:relative;
  background:url('https://www.garvanacoustic.com/wp-content/uploads/2025/10/bg_Garvan.jpg') center/cover no-repeat;
  color:#fff;
  text-align:center;
  padding:80px 20px;
  border-radius:20px;
  overflow:hidden;
  width:90vw;
  max-width:1400px;
  margin:60px auto;
  left:50%;
  transform:translateX(-50%);
}

.newsletter-section.bg-image:before{
  content:"";
  position:absolute;
  inset:0;
  background:rgba(0,0,0,.5);
  z-index:1;
}

.newsletter-wrapper{
  position:relative;
  z-index:2;
  width:100%;
  max-width:1100px;
  margin:0 auto;
}

.newsletter-text h2{
  font-size:28px;
  font-weight:700;
  margin:0 0 15px;
  color:#fff;
}

.newsletter-text p{
  color:#eee;
  font-size:16px;
  line-height:1.6;
  margin:0 0 30px;
}

.newsletter-section .wpcf7,
.newsletter-section .wpcf7-form{
  width:100%;
}

.newsletter-section .wpcf7-form{
  display:flex;
  flex-direction:column;
  gap:20px;
  align-items:center;
}

.newsletter-section .wpcf7-form p{
  margin:0;
}

.newsletter-section .input-group{
  display:flex;
  flex-wrap:wrap;
  gap:15px;
  justify-content:center;
  width:100%;
  max-width:980px;
  margin:0 auto;
}

.newsletter-section .input-group br{display:none!important;}
.newsletter-section .input-group p{display:contents!important;}

.newsletter-section .input-group input[type="text"],
.newsletter-section .input-group input[type="email"]{
  width:100%;
  padding:14px 18px;
  border:none;
  border-radius:10px;
  font-size:15px;
  box-sizing:border-box;
  background:rgba(255,255,255,.15);
  color:#fff;
  transition:background .3s ease;
}

.newsletter-section .input-group input::placeholder{color:rgba(255,255,255,.7);}
.newsletter-section .input-group input:focus{outline:none;background:rgba(255,255,255,.25);}

.newsletter-section .checkbox{
  width:100%;
  max-width:980px;
  margin:0 auto;
  text-align:left;
  color:#ccc;
  font-size:13px;
  line-height:1.6;
}

.newsletter-section .checkbox .wpcf7-list-item{
  margin:0!important;
  display:block;
}

.newsletter-section .checkbox .wpcf7-list-item > label{
  display:flex;
  align-items:flex-start;
  gap:10px;
  cursor:pointer;
  margin:0!important;
  padding:6px 0;
}

.newsletter-section .checkbox input[type="checkbox"]{
  width:18px;
  height:18px;
  margin:4px 0 0 0;
  cursor:pointer;
  flex:0 0 auto;
}

.newsletter-section .checkbox .wpcf7-list-item-label{
  display:block;
  padding-left:20px; /* il tuo “spostamento testo” */
}

.newsletter-section .checkbox a{color:#2f87ff;text-decoration:none;}
.newsletter-section .checkbox a:hover{text-decoration:underline;}

.newsletter-section input[type="submit"]{
  background:#FFD6A0;
  color:#000;
  font-weight:700;
  border:none;
  padding:14px 32px;
  border-radius:10px;
  cursor:pointer;
  transition:all .3s ease;
  font-size:16px;
}
.newsletter-section input[type="submit"]:hover{background:#ffc87a;transform:translateY(-2px);}

.newsletter-section .wpcf7-response-output{color:#fff;border:none!important;margin-top:10px;}

@media (min-width:1025px){
  .newsletter-section .input-group{flex-wrap:nowrap;gap:22px;}
  .newsletter-section .input-group .wpcf7-form-control-wrap{
    flex:0 0 calc(33.333% - 14.7px);
    min-width:0;
  }
}

@media (min-width:769px) and (max-width:1024px){
  .newsletter-section .input-group{gap:18px;}
  .newsletter-section .input-group .wpcf7-form-control-wrap{
    flex:1 1 calc(50% - 9px);
    min-width:260px;
  }
  .newsletter-section .input-group .wpcf7-form-control-wrap[data-name="your-email"]{flex:1 1 100%;}
}

@media (max-width:768px){
  .newsletter-section.bg-image{
    padding:60px 18px;
    width:calc(100vw - 24px);
    margin:28px auto;
    border-radius:18px;
  }
  .newsletter-wrapper{max-width:560px;}
  .newsletter-section .input-group {flex-direction:column;gap:14px;}
  .newsletter-section .checkbox{font-size:13px;}
  .newsletter-section .checkbox input[type="checkbox"]{width:20px;height:20px;margin-top:3px;}
}

/* =========================================================
   GARVAN – GRID DIFFUSORI (GLOBAL)
========================================================= */
.ga-fullwidth-section {
  margin-top: 0 !important;
  padding-top: 0 !important;
}

/* ===== RESET CONTAINER (solo sezioni Garvan) ===== */
.ga-fullwidth-section > .container {
  width: 100% !important;
  max-width: 100% !important;
}

.ga-fullwidth-section > .container > .row {
  margin-left: 0 !important;
  margin-right: 0 !important;
}

.ga-fullwidth-section .vc_column_container,
.ga-fullwidth-section .vc_column-inner {
  padding-left: 0 !important;
  padding-right: 0 !important;
}


/* ===== GRID ===== */
.ga-diffusori-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 22px;
  width: 90%;
  max-width: 1600px;
  margin: 70px auto;
}


/* ===== CARD ===== */
.ga-diffusori-card {
  position: relative;
  display: block;
  height: 300px;
  border-radius: 20px;
  overflow: hidden;
  text-decoration: none;
  -webkit-tap-highlight-color: transparent;
}


/* ===== IMMAGINE ===== */
.ga-card-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  transition: transform 0.8s ease;
}


/* ===== OVERLAY ===== */
.ga-card-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      to top,
      rgba(0,0,0,0.58) 0%,
      rgba(0,0,0,0.20) 45%,
      rgba(0,0,0,0.02) 72%
    ),
    rgba(0,0,0,0.14);
  pointer-events: none;
}


/* ===== TESTO ===== */
.ga-card-label {
  position: absolute;
  bottom: 22px;
  right: 22px;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  z-index: 2;
  color: #fff;
  transition: transform 0.35s ease;
}

.ga-card-title {
  font-size: 17px;
  letter-spacing: 0.07em;
  font-weight: 600;
  text-transform: uppercase;
  line-height: 1.15;
  text-align: right;
}

.ga-card-arrow {
  font-size: 18px;
  transition: transform 0.35s ease;
}


/* ===== HOVER ===== */
.ga-diffusori-card:hover .ga-card-bg {
  transform: scale(1.03);
}

.ga-diffusori-card:hover .ga-card-label {
  transform: translateY(-4px);
}

.ga-diffusori-card:hover .ga-card-arrow {
  transform: translateX(6px);
}


/* ===== RESPONSIVE ===== */
@media (max-width: 1024px) {
  .ga-diffusori-grid {
    grid-template-columns: repeat(2, 1fr);
    width: 92%;
    gap: 22px;
  }

  .ga-diffusori-card {
    height: 260px;
  }
}

@media (max-width: 640px) {
  .ga-diffusori-grid {
    grid-template-columns: 1fr;
    width: 100%;
    gap: 18px;
    margin: 50px 0;
  }

  .ga-diffusori-card {
    height: 300px;
    border-radius: 18px;
  }

  .ga-card-title {
    font-size: 16px;
  }
}


/* ===== SFONDO SEZIONE ===== */
.ga-bg-soft-gradient {
  background: linear-gradient(0deg, #e3e3e3, transparent);
}

/* =========================
   GARVAN DAY FORM
   ========================= */

.day.gd-form {
    max-width: 800px;
    margin: 0 auto;
    padding: 46px 36px;
    background: #d8d8d8;
    border-radius: 28px;
    color: #2f2f2f;
    box-sizing: border-box;
}

.day.gd-form * {
    box-sizing: border-box;
}

/* INTRO */
.gd-form-intro {
    margin-bottom: 30px;
}

.gd-eyebrow {
    display: block;
    font-size: 12px;
    line-height: 1.5;
    text-transform: uppercase;
    letter-spacing: 1.4px;
    font-weight: 700;
    color: #666;
    margin-bottom: 14px;
}

.gd-form-intro h2 {
    font-size: 46px;
    line-height: 1.05;
    font-weight: 700;
    color: #2f2f2f;
    margin: 0 0 14px 0;
}

.gd-form-intro p {
    font-size: 17px;
    line-height: 1.65;
    color: #555;
    margin: 0 0 10px 0;
}

.gd-note {
    font-size: 14px !important;
    color: #666 !important;
}

/* SECTIONS */
.gd-section {
    margin-top: 34px;
}

.gd-section h3,
.gd-label {
    display: block;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: #2f2f2f;
    margin: 0 0 14px 0;
}

/* INPUTS */
.day.gd-form input[type="text"],
.day.gd-form input[type="tel"],
.day.gd-form input[type="email"],
.day.gd-form textarea {
    width: 100%;
    background: #ffffff;
    border: 1px solid #cfcfcf;
    border-radius: 14px;
    padding: 16px 18px;
    font-size: 16px;
    line-height: 1.4;
    color: #2f2f2f;
    margin: 0 0 14px 0;
    box-shadow: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

.day.gd-form input[type="text"]:focus,
.day.gd-form input[type="tel"]:focus,
.day.gd-form input[type="email"]:focus,
.day.gd-form textarea:focus {
    outline: none;
    border-color: #c8a15a;
    box-shadow: 0 0 0 3px rgba(200, 161, 90, 0.14);
    background: #fff;
}

.day.gd-form textarea {
    min-height: 100px;
    resize: vertical;
}

.day.gd-form input::placeholder,
.day.gd-form textarea::placeholder {
    color: #9a9a9a;
    opacity: 1;
}

/* CHECKBOX GENERALI (più grandi) */

.day.gd-form input[type="checkbox"]{
    transform: scale(1.5);
    margin-right: 10px;
    cursor: pointer;
    accent-color: #000;
}

/* LINGUE */

.gd-lang {
    margin-top: 6px;
}

.gd-lang .wpcf7-list-item {
    display: inline-block;
    margin: 0 18px 12px 0;
}

.gd-lang label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
}

.gd-lang .wpcf7-list-item-label {
    font-size: 16px;
    color: #333;
}

/* EXPERIENCE BOX */

.gd-experience-box {
    background: #ededed;
    border: 1px solid #d3d3d3;
    border-radius: 22px;
    padding: 24px 22px;
}

.gd-experience-box h3 {
    margin-top: 0;
}

.gd-small {
    font-size: 14px;
    line-height: 1.6;
    color: #666;
    margin: 0 0 16px 0;
}

.gd-exp-item {
    padding: 16px 0;
    border-top: 1px solid #d8d8d8;
}

.gd-exp-item:first-of-type {
    border-top: none;
    padding-top: 4px;
}

.gd-exp-item strong {
    display: block;
    font-size: 18px;
    line-height: 1.35;
    color: #2f2f2f;
    margin-bottom: 5px;
}

.gd-exp-meta {
    font-size: 15px;
    line-height: 1.6;
    color: #666;
}

.gd-exp-disabled {
    opacity: 0.6;
}

.gd-exp-check {
    margin-top: 12px;
}

.gd-exp-check .wpcf7-list-item {
    margin: 0;
}

.gd-exp-check label {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #ffffff;
    border: 1px solid #d0d0d0;
    border-radius: 999px;
    padding: 10px 16px;
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease;
}

.gd-exp-check label:hover {
    background: #fafafa;
    border-color: #c1c1c1;
}

.gd-exp-check .wpcf7-list-item-label {
    font-size: 15px;
    color: #333;
}

/* PRIVACY */

.gd-privacy {
    font-size: 15px;
    line-height: 1.75;
    color: #444;
}

.gd-privacy label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
}

.gd-privacy a {
    text-decoration: underline;
}

/* SUBMIT */

.gd-submit {
    margin-top: 30px;
}

.day.gd-form input[type="submit"] {
    background: #000;
    color: #fff;
    border: none;
    border-radius: 999px;
    padding: 14px 30px;
    font-size: 13px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
}

.day.gd-form input[type="submit"]:hover {
    opacity: 0.92;
    transform: translateY(-1px);
}

/* RESPONSE MESSAGES */

.day.gd-form .wpcf7-response-output {
    margin: 20px 0 0 0;
    border-radius: 12px;
    padding: 12px 16px;
    font-size: 14px;
}

/* TABLET */

@media screen and (max-width: 992px) {

    .day.gd-form {
        padding: 38px 28px;
    }

    .gd-form-intro h2 {
        font-size: 38px;
    }

}

/* MOBILE */

@media screen and (max-width: 600px) {

    .day.gd-form {
        padding: 26px 18px;
        border-radius: 18px;
    }

    .gd-eyebrow {
        font-size: 11px;
        margin-bottom: 10px;
    }

    .gd-form-intro h2 {
        font-size: 32px;
        line-height: 1.08;
    }

    .gd-form-intro p {
        font-size: 15px;
        line-height: 1.6;
    }

    .gd-section {
        margin-top: 28px;
    }

    .gd-experience-box {
        padding: 20px 16px;
        border-radius: 16px;
    }

    .gd-lang .wpcf7-list-item {
        display: block;
        margin: 0 0 12px 0;
    }

    .gd-exp-check label {
        width: 100%;
    }

    .day.gd-form input[type="text"],
    .day.gd-form input[type="tel"],
    .day.gd-form input[type="email"],
    .day.gd-form textarea {
        font-size: 16px;
    }

}

/* ===== GARVAN ARTICLE MASTER CSS ===== */

.ga-article {
  max-width: 900px;
  margin: 0 auto;
  color: #222;
  font-size: 18px;
  line-height: 1.75;
}

.ga-article h1,
.ga-article h2,
.ga-article h3 {
  color: #111;
  line-height: 1.2;
  margin: 0;
}

.ga-article h1 {
  font-size: 42px;
  margin-bottom: 28px;
}

.ga-article h2 {
  font-size: 30px;
  margin-top: 56px;
  margin-bottom: 18px;
}

.ga-article h3 {
  font-size: 22px;
  margin-top: 12px;
  margin-bottom: 12px;
}

.ga-article p {
  margin: 0 0 18px 0;
}

.ga-article ul,
.ga-article ol {
  margin: 0 0 26px 24px;
  padding: 0;
}

.ga-article li {
  margin-bottom: 12px;
}

.ga-article strong {
  color: #111;
}

.ga-article a {
  color: #111;
  text-decoration: underline;
  text-underline-offset: 3px;
}

.ga-article__intro {
  font-size: 20px;
  color: #333;
  margin-bottom: 28px;
}

.ga-article__image {
  margin: 34px 0;
}

.ga-article__image img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 18px;
}

.ga-article__caption {
  font-size: 14px;
  line-height: 1.5;
  color: #666;
  margin-top: 10px;
}

.ga-article__media {
  margin: 34px 0;
}

.ga-article__media iframe,
.ga-article__media video {
  width: 100%;
  border: 0;
  border-radius: 18px;
  display: block;
}

.ga-article__note {
  margin: 32px 0;
  padding: 22px 24px;
  background: #f6f6f6;
  border-radius: 18px;
  font-size: 17px;
  line-height: 1.7;
}

.ga-article__cta {
  margin-top: 48px;
  padding: 28px;
  background: #f6f6f6;
  border-radius: 22px;
}

.ga-article__cta-title {
  font-size: 24px;
  font-weight: 700;
  margin-bottom: 12px;
  color: #111;
}

.ga-article__spacer {
  height: 8px;
}

.ga-article__faq {
  margin-top: 56px;
}

.ga-faq-item {
  border-bottom: 1px solid #e7e7e7;
}

.ga-faq-item:first-of-type {
  border-top: 1px solid #e7e7e7;
}

.ga-faq-item summary {
  list-style: none;
  cursor: pointer;
  position: relative;
  padding: 18px 42px 18px 0;
  font-size: 20px;
  font-weight: 600;
  line-height: 1.4;
  color: #111;
}

.ga-faq-item summary::-webkit-details-marker {
  display: none;
}

.ga-faq-item summary::after {
  content: "+";
  position: absolute;
  right: 0;
  top: 18px;
  font-size: 24px;
  line-height: 1;
  font-weight: 400;
  color: #111;
}

.ga-faq-item[open] summary::after {
  content: "–";
}

.ga-faq-content {
  padding: 0 0 18px 0;
}

.ga-faq-content p {
  margin: 0;
}

@media (max-width: 768px) {
  .ga-article {
    font-size: 17px;
    line-height: 1.7;
  }

  .ga-article h1 {
    font-size: 34px;
    margin-bottom: 22px;
  }

  .ga-article h2 {
    font-size: 26px;
    margin-top: 42px;
    margin-bottom: 16px;
  }

  .ga-article h3 {
    font-size: 20px;
    margin-top: 26px;
  }

  .ga-article__intro {
    font-size: 18px;
  }

  .ga-article__note,
  .ga-article__cta {
    padding: 22px 20px;
  }

  .ga-faq-item summary {
    font-size: 18px;
    padding: 16px 36px 16px 0;
  }

  .ga-faq-item summary::after {
    top: 16px;
    font-size: 22px;
  }
}
/* =====================================================
   SOLUTION CARD - Articoli acustica
   Card prodotto con testo + CTA + immagine
===================================================== */

.ga-article .ga-solution-card{
  margin:50px 0;
  padding:32px;
  border-radius:22px;
  background:linear-gradient(135deg,#f7f5f2,#f0ebe5);
  border:1px solid #e3ddd5;
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:36px;
}

.ga-article .ga-solution-card__text{
  flex:1;
  min-width:280px;
}

.ga-article .ga-solution-card__text h2{
  margin:0 0 18px;
  font-size:28px;
  line-height:1.15;
  color:#111;
}

.ga-article .ga-solution-card__text h3{
  margin:0 0 14px;
  font-size:22px;
  line-height:1.15;
  text-transform:uppercase;
  color:#111;
}

.ga-article .ga-solution-card__text p{
  color:#555;
}

.ga-article .ga-solution-card__link,
.ga-article .ga-solution-card__link:link,
.ga-article .ga-solution-card__link:visited{
  display:inline-flex;
  align-items:center;
  gap:10px;
  margin-top:14px;
  padding:14px 22px;
  border-radius:14px;
  background:#2f2f31;
  color:#ffffff !important;
  text-decoration:none !important;
  font-weight:700;
  font-size:15px;
  line-height:1.2;
}

.ga-article .ga-solution-card__link:hover{
  background:#1f1f20;
  color:#ffffff !important;
  text-decoration:none !important;
}

.ga-article .ga-solution-card__media{
  flex:1;
  min-width:280px;
}

.ga-article .ga-solution-card__media img{
  width:100%;
  height:auto;
  border-radius:16px;
  display:block;
}

@media (max-width: 767px){
  .ga-article .ga-solution-card{
    padding:24px;
    gap:24px;
  }

  .ga-article .ga-solution-card__text,
  .ga-article .ga-solution-card__media{
    flex:1 1 100%;
    min-width:100%;
  }

  .ga-article .ga-solution-card__text h2{
    font-size:24px;
  }

  .ga-article .ga-solution-card__text h3{
    font-size:19px;
  }

  .ga-article .ga-solution-card__link{
    width:100%;
    justify-content:center;
  }
}
/* =====================================================
   GARVAN PRODUCT SYSTEM – START
   Template: on-wall / in-wall / outdoor / suspended
===================================================== */

/* =========================
   HERO PRODOTTO
========================= */

.ga-hero {
  width: 100%;
  margin: 0 auto;
  position: relative;
  overflow: hidden;
  aspect-ratio: 16 / 9;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.ga-hero-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 30%;
  background: linear-gradient(
    to top,
    rgba(0,0,0,0.88) 0%,
    rgba(0,0,0,0.68) 35%,
    rgba(0,0,0,0.32) 62%,
    rgba(0,0,0,0.0) 100%
  );
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 clamp(16px, 3vw, 32px);
  box-sizing: border-box;
}

.ga-hero-content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(16px, 2.6vw, 22px);
  transform: translateX(-2%);
}

.ga-hero-title {
  color: #ffffff;
  font-family: Montserrat, Arial, sans-serif;
  font-weight: 700;
  font-size: clamp(26px, 4.2vw, 50px);
  line-height: 1;
  letter-spacing: 0.5px;
  white-space: nowrap;
  text-transform: uppercase;
}

.ga-hero-arrow {
  width: 52px;
  height: 52px;
  border-radius: 999px;
  border: 2px solid rgba(255,255,255,0.9);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  background: rgba(255,255,255,0.02);
}

.ga-hero-arrow svg {
  display: block;
}

@media (max-width: 768px) {
  .ga-hero {
    margin-top: 83px !important;
  }

  .ga-hero-content {
    display: none !important;
  }
}

@media (min-width: 769px) {
  .ga-hero-arrow {
    animation: ga-bounce 2.4s ease-in-out infinite;
  }

  @keyframes ga-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }
}

/* =========================
   01. WRAPPER BASE
========================= */

.ga-product {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.ga-product-section {
  margin: 0 0 28px 0;
  padding: 0 !important;
}

.ga-product-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  align-items: stretch;
}

/* =========================
   02. CARD BASE
========================= */

.ga-product-card {
  background: #ffffff;
  border: 1px solid #eeeeee;
  border-radius: 18px;
  padding: 26px 24px;
  box-shadow: 0 10px 26px rgba(0,0,0,0.04);
  flex: 1 1 320px;
}


/* =========================
   03. TITOLI E TESTI
========================= */

.ga-product-title {
  margin: 0 0 14px 0;
  font-size: 18px;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  line-height: 1.2;
}

.ga-product-subtitle {
  display: block;
  margin-top: 4px;
  color: #6a6a6a;
  font-weight: 600;
}

.ga-product-text {
  font-size: 16px;
  line-height: 1.75;
  color: #2a2a2a;
  margin: 14px 0 0 0;
}


/* =========================
   04. DATI TECNICI
========================= */

.ga-product-tech-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 16px;
}

.ga-product-tech-item {
  border: 1px solid #efefef;
  border-radius: 14px;
  padding: 14px 16px;
  background: #fafafa;
}

.ga-product-tech-item strong {
  display: block;
  font-size: 18px;
  font-weight: 700;
  line-height: 1.2;
}

.ga-product-tech-item span {
  display: block;
  margin-top: 8px;
  font-size: 13px;
  color: #6a6a6a;
  line-height: 1.4;
}


/* =========================
   05. DOWNLOAD
========================= */

.ga-product-grid--tech-download {
  align-items: stretch;
}

.ga-product-grid--tech-download .ga-product-tech {
  flex: 2 1 620px;
}

.ga-product-grid--tech-download .ga-product-download {
  flex: 1 1 340px;
}

.ga-product-download .ga-product-title {
  margin-bottom: 18px;
}

.ga-product-download .ga-btn,
.ga-product-download-list a {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  text-decoration: none;
  border-radius: 12px;
  padding: 14px 16px;
  font-size: 14px;
  font-weight: 600;
  line-height: 1.2;
  transition: all 0.25s ease;
  box-sizing: border-box;
}

/* bottone principale nero */
.ga-btn.ga-btn--dark {
  background: #303030;
  color: #ffffff;
  border: 1px solid #303030;
}

.ga-btn.ga-btn--dark:hover {
  background: #1f1f1f;
  color: #ffffff;
}

/* bottone secondario bianco */
.ga-btn.ga-btn--outline-dark {
  background: #ffffff;
  color: #1e1e1e;
  border: 1px solid #1e1e1e;
}

.ga-btn.ga-btn--outline-dark:hover {
  background: #f7f7f7;
  color: #1e1e1e;
}

.ga-product-download-list {
  margin-top: 10px;
  padding-top: 0;
  border-top: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.ga-product-download-list a {
  background: #ffffff;
  color: #1e1e1e;
  border: 1px solid #1e1e1e;
}

.ga-product-download-list a:hover {
  background: #f7f7f7;
  color: #1e1e1e;
}

.ga-product-download .ga-btn span:last-child,
.ga-product-download-list a span:last-child {
  font-size: 16px;
  line-height: 1;
  flex: 0 0 auto;
}

/* =========================
   06. FEATURE BLOCKS
========================= */

.ga-product-feature {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  align-items: stretch;
}

.ga-product-feature-text {
  flex: 1 1 520px;
  background: #ffffff;
  border: 1px solid #eeeeee;
  border-radius: 18px;
  padding: 26px 24px;
  box-shadow: 0 10px 26px rgba(0,0,0,0.04);
}

.ga-product-feature-media {
  flex: 1 1 360px;
  border-radius: 18px;
  overflow: hidden;
  background: #f3f3f3;
  box-shadow: 0 14px 32px rgba(0,0,0,0.06);
}

.ga-product-feature-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}


/* alternanza layout */
.ga-product-feature.is-reverse {
  flex-direction: row-reverse;
}


/* =========================
   07. LISTE
========================= */

.ga-product-list {
  margin-top: 14px;
  padding-left: 18px;
}

.ga-product-list li {
  margin-bottom: 8px;
  font-size: 15px;
  line-height: 1.6;
}


/* =========================
   08. METRICHE (suono)
========================= */

.ga-product-metrics {
  display: flex;
  gap: 14px;
  margin-top: 16px;
  flex-wrap: wrap;
}

.ga-product-metrics div {
  border: 1px solid #efefef;
  border-radius: 12px;
  padding: 12px 14px;
  background: #fafafa;
}

.ga-product-metrics strong {
  display: block;
  font-size: 16px;
  font-weight: 700;
}

.ga-product-metrics span {
  font-size: 12px;
  color: #6a6a6a;
}


/* =========================
   09. VIDEO + TESTO 50/50
========================= */

.ga-product-video-row {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  align-items: stretch;
}

.ga-product-video-row .ga-product-video-text,
.ga-product-video-row .ga-product-video-media {
  flex: 1 1 420px;
}

.ga-product-video-text {
  background: #ffffff;
  border: 1px solid #eeeeee;
  border-radius: 18px;
  padding: 26px 24px;
  box-shadow: 0 10px 26px rgba(0,0,0,0.04);
}

.ga-product-video-media {
  background: #ffffff;
  border: 1px solid #eeeeee;
  border-radius: 18px;
  padding: 18px;
  box-shadow: 0 10px 26px rgba(0,0,0,0.04);
}

.ga-product-video-wrapper {
  width: 100%;
  aspect-ratio: 16 / 9;
  border-radius: 14px;
  overflow: hidden;
  background: #000;
}

.ga-product-video-wrapper iframe {
  width: 100%;
  height: 100%;
  display: block;
  border: 0;
}

@media (max-width: 768px) {
  .ga-product-video-row {
    flex-direction: column;
  }
}

/* =========================
   10. TEMPLATE MODIFIERS
========================= */

/* IN-WALL */
.ga-template-inwall .ga-product-feature-text {
  border-left: 3px solid #eaeaea;
}

/* OUTDOOR */
.ga-template-outdoor .ga-product-card {
  background: #ffffff;
}

/* ON-WALL */
.ga-template-onwall .ga-product-feature-media {
  background: #f6f6f6;
}

/* SUSPENDED */
.ga-template-suspended .ga-product-feature-media {
  box-shadow: 0 20px 40px rgba(0,0,0,0.08);
}


/* =========================
   11. RESPONSIVE
========================= */
@media (max-width: 768px) {
  .ga-product-section {
    margin: 0 0 20px 0;
    padding: 0 !important;
  }

  .ga-product-feature {
    flex-direction: column;
  }

  .ga-product-feature.is-reverse {
    flex-direction: column;
  }

  .ga-product-tech-grid {
    grid-template-columns: 1fr;
  }

  .ga-product-video-row {
    flex-direction: column;
  }
}

/* =========================
   12. FULL IMAGE SECTION (AMBIENTI)
========================= */

.ga-product-image-full {
  margin: 0 0 28px 0;
}

.ga-product-image-full-inner {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.ga-product-image-full img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 18px;
}

/* Variante con crop (opzionale, per immagini più cinematiche) */
.ga-product-image-full.is-cover img {
  height: 420px;
  object-fit: cover;
}

/* Mobile */
@media (max-width: 768px) {

  .ga-product-image-full {
    margin: 0 0 20px 0;
  }

  .ga-product-image-full.is-cover img {
    height: 260px;
  }

}

/* =====================================================
   GARVAN PRODUCT SYSTEM – END
===================================================== */

		</style>
