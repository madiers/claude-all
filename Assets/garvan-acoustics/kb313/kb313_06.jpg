		</script>
		<script>
(function () {
  function normalize(url) {
    if (!url) return url;

    // relativo -> assoluto
    url = url.replace(/^wp-json\//, "/wp-json/");

    // /fr/wp-json/ -> /wp-json/
    url = url.replace(/^\/?(fr|de|es|it|en)\/wp-json\//, "/wp-json/");

    // assoluto con lingua -> assoluto senza lingua
    url = url.replace(/https?:\/\/[^\/]+\/(fr|de|es|it|en)\/wp-json\//, window.location.origin + "/wp-json/");

    return url;
  }

  function fixRoot() {
    if (window.wpcf7 && wpcf7.apiSettings && wpcf7.apiSettings.root) {
      wpcf7.apiSettings.root = normalize(wpcf7.apiSettings.root);
    }
  }

  fixRoot();
  document.addEventListener("wpcf7init", fixRoot);

  document.addEventListener("wpcf7beforesubmit", function (event) {
    if (event.detail && event.detail.api && event.detail.api.endpoint) {
      event.detail.api.endpoint = normalize(event.detail.api.endpoint);
    }
  }, true);
})();
</script>
        


