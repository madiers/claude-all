<noscript><style>.lazyload[data-src]{display:none !important;}</style></noscript><style>.lazyload{background-image:none !important;}.lazyload:before{background-image:none !important;}</style><script>document.addEventListener('DOMContentLoaded', function () {
  const carousel = document.querySelector('.surface-variants-carousel__track');
  if (!carousel) return;

  const card = carousel.querySelector('.surface-variant-card');
  if (!card) return;

  const gap = parseInt(getComputedStyle(carousel).gap) || 20;
  const cardWidth = card.offsetWidth + gap;

  const next = document.querySelector('.svc-arrow--next');
  const prev = document.querySelector('.svc-arrow--prev');

  if (next) {
    next.addEventListener('click', function (e) {
      e.preventDefault();
      carousel.scrollBy({ left: cardWidth, behavior: 'smooth' });
    });
  }

  if (prev) {
    prev.addEventListener('click', function (e) {
      e.preventDefault();
      carousel.scrollBy({ left: -cardWidth, behavior: 'smooth' });
    });
  }
});
</script><!-- Pinterest Tag -->
